{
  "name": "multi-agent-memory",
  "productName": "MultiAgent Memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "多 Agent 记忆助手 - 多页面接入 + TS 内核 + Electron 端壳",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json",
    "dev": "node tools/dev.mjs",
    "dev:backend": "node tools/dev-backend.mjs",
    "build": "vite build",
    "build:electron": "node tools/build-electron.cjs",
    "package:win": "npm run build && npm run build:electron && node tools/package-win.cjs",
    "prepackage": "npm run code:index -- --write",
    "prepackage:win": "npm run code:index -- --write",
    "package": "npm run build && npm run build:electron && node tools/prepare-electron-dist.cjs && node tools/package-builder.cjs",
    "test:e2e": "node e2e/run.mjs --workers=1",
    "test:e2e:install": "playwright install chromium",
    "code:index": "node tools/code-index.mjs",
    "code:index:check": "node tools/code-index.mjs --check",
    "rejudge": "node tools/rejudge-dry.mjs",
    "verify:fast": "npm run typecheck && npm run lint && npm run code:index:check && npm run test:coverage",
    "verify": "npm run verify:fast && npm run build:electron && npm run test:e2e"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
