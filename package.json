{
  "name": "multi-agent-memory",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "多 Agent 记忆助手 - REQ-003 Agent 接入页（TS 内核 + React UI + 零依赖 HTTP 后端）",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "vite build",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:install": "playwright install chromium",
    "verify": "npm run typecheck && npm run test && python tools/validate_project.py && python tools/generate.py --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
